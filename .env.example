# --- Frontend (exposed to the browser; only public values!) ---
# Supabase project URL and anon/public key (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: 'demo' runs the booking flow on in-browser demo data instead of Supabase
# VITE_DATA_SOURCE=demo

# --- Server only: set as Supabase Edge Function secrets, NEVER prefix with VITE_ ---
# supabase secrets set RESEND_API_KEY=... EMAIL_FROM=... STUDIO_NOTIFICATION_EMAIL=...
# SUPABASE_SERVICE_ROLE_KEY is injected automatically into Edge Functions.
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM="Nr5 Studios <booking@your-verified-domain.no>"
